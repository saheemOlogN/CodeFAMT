# Leave NODE_ENV unset locally; set it to production on the deployed server.
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/codefamt
REDIS_URL=redis://127.0.0.1:6379
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
ADMIN_EMAILS=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CodeFAMT <noreply@famt.ac.in>
# OnlineCompiler REST API key. Never add a VITE_ prefix to this variable.
COMPILER_API_URL=https://api.onlinecompiler.io
COMPILER_API_KEY=
JUDGE_CONCURRENCY=2
COMPILER_REQUESTS_PER_SECOND=2
